# Ambiente di test (oc:8333). L'isolamento del database deve valere per tutti
# i dev, non solo per chi lo configura a mano: per questo il modello e'
# versionato con DB_DATABASE gia' impostato.
#
# Laravel carica questo file AL POSTO di .env quando APP_ENV=testing, non in
# aggiunta: ogni variabile che serve ai test va replicata qui.
#
# Questo file e' il modello: `scripts/install.sh` ne ricava `.env.testing`,
# che NON e' versionato (.gitignore) e riceve APP_KEY e JWT_SECRET generate
# localmente. Nessun segreto vive in un file tracciato, nemmeno di test.
APP_NAME=forestas
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=forestas_testing
DB_USERNAME=forestas
DB_PASSWORD=forestas

REDIS_HOST=redis
REDIS_PORT=6379
SCOUT_DRIVER=collection
JWT_SECRET=
JWT_TTL=60

# Dominio opzionale del Catasto Sentieri (oc:8492): serve ai comandi artisan
# lanciati con --env=testing, che leggono questo file e non phpunit.xml.
WM_TRAIL_REGISTRY_ENABLED=true
