# Ambiente di test (oc:8333). File versionato: l'isolamento del database
# deve valere per tutti i dev, non solo per chi lo configura a mano.
#
# Laravel carica questo file AL POSTO di .env quando APP_ENV=testing, non in
# aggiunta: ogni variabile che serve ai test va replicata qui.
#
# APP_KEY e JWT_SECRET sono generate apposta per i test e non coincidono con
# quelle di sviluppo o di produzione: cifrano solo dati di un database
# effimero.
APP_NAME=forestas
APP_ENV=testing
APP_KEY=base64:qTiryV83ycXZH1WGsXGT7BH27kAcoDuV5erUgKwAbOA=
APP_DEBUG=true
APP_URL=http://localhost
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=forestas_testing
DB_USERNAME=forestas
DB_PASSWORD=forestas

REDIS_HOST=redis
REDIS_PORT=6379
SCOUT_DRIVER=collection
JWT_SECRET=N3uED4wD+uJgHk0rdvu8tXfdJF1Ovm6gaZLkOn1cgc23PWW10CSJBXyBVLNxsCKg
JWT_TTL=60

# Dominio opzionale del Catasto Sentieri (oc:8492): serve ai comandi artisan
# lanciati con --env=testing, che leggono questo file e non phpunit.xml.
WM_TRAIL_REGISTRY_ENABLED=true
